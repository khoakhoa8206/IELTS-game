# Sao chép thành .env rồi điền (chỉ dùng khi chạy trên máy cá nhân; trên Render điền trong Dashboard)
PORT=3000
TEACHER_USER=giaovien
TEACHER_PASSWORD=
# Supabase: Project Settings → API. Bỏ trống thì chạy bằng bộ nhớ tạm (tắt máy là mất dữ liệu)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# AI qua OpenRouter (openrouter.ai/keys): đọc đề Reading/Listening và chấm Writing. Bỏ trống thì tắt AI
OPENROUTER_API_KEY=
# đổi model nếu muốn (xem giá ở openrouter.ai/models)
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_WRITING_MODEL=google/gemini-3.8-flash
# Dùng model miễn phí chỉ đọc chữ (vd. apodex/apodex-1.1-mini:free): đặt cả 2 model ở trên thành model đó và bật dòng dưới
# để OpenRouter chuyển PDF thành chữ miễn phí (chỉ được với PDF có chữ, không được với ảnh / bản scan)
# OPENROUTER_PDF_ENGINE=cloudflare-ai
